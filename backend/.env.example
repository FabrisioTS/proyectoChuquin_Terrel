# ==========================================================
# Plantilla de configuración (no contiene secretos reales)
# ==========================================================
# No necesitas copiar este archivo: el backend crea "backend/.env"
# automáticamente en el primer arranque, con una SECRET_KEY aleatoria.
#
# Cópialo solo si quieres personalizar valores. El .env real está
# en .gitignore y nunca se sube al repositorio.

# Servidor SQL Server (autenticación de Windows, sin usuario/clave):
#   - Instancia por defecto:      localhost
#   - SQL Server Express LocalDB: (localdb)\MSSQLLocalDB
#   - Express con nombre:         localhost\SQLEXPRESS
DB_SERVER=localhost
DB_NAME=veterinaria_db
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TIMEOUT=10

# Crea la base, la tabla y los usuarios de prueba al arrancar si faltan.
DB_AUTO_INIT=true

# ==========================================================
# Seguridad JWT
# ==========================================================
# El .env generado automáticamente ya incluye una clave aleatoria.
# Si creas este archivo manualmente, genera una con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-por-una-segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
